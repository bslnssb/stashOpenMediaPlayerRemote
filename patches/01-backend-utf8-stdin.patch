+
+def read_plugin_input():
+    """Read Stash's plugin input JSON as UTF-8, independent of the OS code page.
+
+    Stash writes UTF-8 JSON to the plugin's stdin. On Windows, however,
+    sys.stdin.read() decodes using the system ANSI code page (cp936 on a
+    Chinese locale, cp1252 on many Western ones). When a path contains
+    non-ASCII characters, the UTF-8 bytes are decoded incorrectly; worse, the
+    trailing byte of a multi-byte character can be consumed together with the
+    following backslash as one double-byte character. That turns a correctly
+    escaped path separator into a lone backslash and makes json.loads fail
+    with "Invalid \\escape", so the plugin exits before launching anything.
+
+    Reading the raw bytes and decoding them explicitly avoids the locale.
+    """
+    raw = sys.stdin.buffer.read().decode("utf-8", errors="replace")
+    return json.loads(raw)
+
